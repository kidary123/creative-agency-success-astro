---
/**
 * Hero. Fondo #F4F1EF (82:49): y 100 → 696 del lienzo, 596 de alto.
 * Titular 175:447, párrafo 34:3, CTA 38:168, arte 1295:1833, lema 42:65.
 *
 * Dos posiciones que no son decorativas y conviene no "arreglar":
 *
 *   38:168  el botón va de y656 a y715 y el beige acaba en y696, así que
 *           CRUZA el borde: 40px dentro del beige y 19px ya sobre el blanco.
 *   42:65   el lema arranca en y715 — está en la franja blanca, no en el
 *           beige — y su caja (x775, ancho 498) queda centrada bajo el arte.
 *
 * Medidos desde el techo de la sección (y=100): botón 556→615, lema 615.
 *
 * El arte son tres capas con su propio inset (trampa 5): las formas de color,
 * el heptágono de contorno —ambas dentro de hero-formas.svg— y el retrato.
 * Las siete etiquetas van posicionadas por inset en % del bloque de arte, tal
 * como vienen del nodo, no medidas sobre la captura.
 */
import Foto from "../Foto.astro";

const etiquetas = [
  { t: "Purpose",    x: 44.1,  y: 0,     r: 42.59, b: 95.27, fuerte: false },
  { t: "Confidence", x: 83.61, y: 23.74, r: 0,     b: 72.15, fuerte: true },
  { t: "Passion",    x: 7.08,  y: 23.41, r: 81.3,  b: 71.91, fuerte: false },
  { t: "Control",    x: 88.95, y: 64.03, r: 0.04,  b: 31.18, fuerte: false },
  { t: "Fulfilment", x: 0,     y: 63.54, r: 87.87, b: 31.78, fuerte: false },
  { t: "Freedom",    x: 3.56,  y: 90.87, r: 81.26, b: 4.34,  fuerte: false },
  { t: "Growth",     x: 79.21, y: 91.88, r: 9.78,  b: 3.32,  fuerte: false },
];
---

<section class="hero" id="hero">
  <div class="fondo" aria-hidden="true"></div>

  <div class="envoltorio rejilla-hero">
    <div class="texto">
      <h1 data-animate="fade-up">Your Agency Vision Made Real</h1>

      <p class="entrada" data-animate="fade-up" style="--retardo:120ms">
        Creative Agency Owners, we’ve got you. Impact, Freedom and Profit is what we
        want for you. Individual Clarity and Collective Confidence is the path. You
        have found your tribe, welcome home.
      </p>
    </div>

    <div class="arte" data-animate="zoom" style="--retardo:150ms">
      <div class="lienzo">
        <img class="formas" src="/assets/hero-formas.svg" alt="" />
        <Foto id="hero-retrato" alt="Propietario de agencia creativa" clase="retrato" carga="eager" />

        {etiquetas.map((e) => (
          <span
            class:list={["etiqueta", { fuerte: e.fuerte }]}
            style={`--x:${e.x}%; --y:${e.y}%; --r:${e.r}%; --b:${e.b}%;`}
          >{e.t}</span>
        ))}
      </div>
    </div>

    <a class="boton" href="#cta-final" data-animate="fade-up" style="--retardo:240ms">Get Started</a>

    <p class="lema" data-animate="fade-up">You scale your agency. We simplify your life.</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block-start: 66px;
  }

  /* 82:49 — 596px de beige contados desde el techo de la sección. */
  .fondo {
    position: absolute;
    inset: 0 0 auto;
    block-size: 596px;
    background: var(--c-grey);
    z-index: -1;
  }

  .rejilla-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 475fr) minmax(0, 580fr);
    align-items: center;
    gap: 72px;
  }

  .texto { padding-block: 40px 0; }

  h1 {
    font-size: var(--t-h1);
    color: var(--c-azul);
    max-inline-size: 12ch;
  }

  .entrada {
    margin-block-start: 26px;
    max-inline-size: 475px;
    color: var(--c-azul);
    line-height: 1.62;
  }

  /* ---- arte 1295:1833 (579.614 × 438) ---- */
  .arte { justify-self: end; inline-size: 100%; max-inline-size: 580px; }

  .lienzo {
    position: relative;
    aspect-ratio: 579.614 / 438;
  }

  /* inset-[7.08% 12.7% 0 15.18%] del nodo 1295:1549 */
  .formas {
    position: absolute;
    inset-block-start: 7.08%;
    inset-inline-start: 15.18%;
    inline-size: 72.12%;
    block-size: 92.92%;
    object-fit: fill;
  }

  /* inset-[16.67% 15.29% 0 17.77%] del nodo 1295:1565 */
  .arte :global(.retrato) {
    position: absolute;
    inset-block-start: 16.67%;
    inset-inline-start: 17.77%;
    inline-size: 66.94%;
    block-size: 83.33%;
    background: none;
  }

  /* El retrato es un recorte con alfa real: nunca lleva fondo propio. */
  .arte :global(.retrato) { background: none !important; }
  .arte :global(.retrato.falta) { opacity: 0.42; }
  .arte :global(.retrato) img { object-fit: contain; object-position: center bottom; }

  .etiqueta {
    position: absolute;
    inset-inline-start: var(--x);
    inset-inline-end: var(--r);
    inset-block-start: var(--y);
    inset-block-end: var(--b);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--t-cuerpo);
    text-align: center;
    color: var(--c-dgrey);
    white-space: nowrap;
  }

  .etiqueta.fuerte { color: var(--c-azul); font-weight: 700; }

  .lema {
    font-size: var(--t-lema);
    font-weight: 500;
    line-height: 28px;
    text-align: center;
    color: var(--c-azul);
  }

  /* ---- anclaje al borde del beige (solo escritorio) ----
     El botón y el lema se posicionan por su offset real desde el techo de la
     sección, porque su gracia es justamente dónde caen respecto al borde del
     fondo: el botón montado a caballo y el lema ya en el blanco. */
  @media (min-width: 56.25rem) {
    .hero { min-block-size: 651px; }

    .boton {
      position: absolute;
      inset-block-start: 490px;   /* 556 del lienzo − 66 de padding superior */
      inset-inline-start: 0;
      margin: 0;
    }

    .lema {
      position: absolute;
      inset-block-start: 555px;   /* 615 del lienzo − 66 */
      /* 42:65 mide 498 y arranca en x775 sobre un ancho útil de 1240 */
      inset-inline-start: 54.44%;
      inline-size: 40.16%;
    }
  }

  @media (max-width: 1200px) {
    .rejilla-hero { gap: 40px; }
    .fondo { block-size: calc(100% - 56px); }

    @media (min-width: 56.25rem) {
      .hero { min-block-size: 0; padding-block-end: 96px; }
      .boton { inset-block-start: auto; inset-block-end: 56px; }
      .lema { inset-block-start: auto; inset-block-end: 0; }
    }
  }

  /* ---- táctil: todo vuelve al flujo ---- */
  @media (max-width: 56.25rem) {
    .hero { padding-block: 40px 0; }

    .rejilla-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }

    .arte { justify-self: center; order: -1; max-inline-size: 460px; }
    h1 { max-inline-size: none; }
    .entrada { max-inline-size: none; }

    /* El beige llega hasta la mitad del botón; el lema queda ya en blanco. */
    .fondo { block-size: calc(100% - 92px); }

    .boton { margin-block-start: 32px; justify-self: start; }
    .lema { margin-block-start: 34px; text-align: start; }

    .etiqueta { font-size: 12px; }
  }
</style>
