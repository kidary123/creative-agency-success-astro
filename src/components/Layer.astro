---
/**
 * Una capa de arte, posicionada por su PROPIO inset (nunca el del componente
 * contenedor). Resuelve la trampa 5 completa:
 *
 *  - preserveAspectRatio="none" en los SVG exportados estira el dibujo si la
 *    caja no es la suya → cada capa lleva su inset en % del contenedor.
 *  - Las capas giradas se miden con los ejes cambiados → container-type: size
 *    y 100cqh / 100cqw intercambiados.
 *  - Centrar una capa girada solo funciona con translate: el interior es más
 *    ancho que su caja, place-items la empuja al borde y margin:auto se niega
 *    a hacerse negativo.
 *  - translate y rotate van como propiedades sueltas, no dentro de transform,
 *    para no pisar el transform del hover, que vive en la caja de fuera.
 */
interface Props {
  src: string;
  alt?: string;
  inset: { x: number; y: number; w: number; h: number };
  rotacion?: number;
  /** Factor de inflado cuando el SVG se exporta con el sangrado del trazo. */
  sangrado?: { x: number; y: number } | null;
  clase?: string;
}

const { src, alt = "", inset, rotacion = 0, sangrado = null, clase = "" } = Astro.props;
const girada = rotacion % 180 !== 0;
---

<div
  class:list={["capa", { girada }, clase]}
  style={`
    --x:${inset.x}%; --y:${inset.y}%; --w:${inset.w}%; --h:${inset.h}%;
    --rot:${rotacion}deg;
    --sx:${sangrado?.x ?? 1}; --sy:${sangrado?.y ?? 1};
  `}
>
  <img src={src} alt={alt} />
</div>

<style>
  .capa {
    position: absolute;
    inset-inline-start: var(--x);
    inset-block-start: var(--y);
    inline-size: var(--w);
    block-size: var(--h);
    container-type: size;
    pointer-events: none;
  }

  .capa img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: fill;
    scale: var(--sx) var(--sy);
  }

  /* Girada: los ejes se intercambian y el centrado solo lo resuelve translate. */
  .capa.girada img {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    inline-size: 100cqh;
    block-size: 100cqw;
    rotate: var(--rot);
    translate: -50% -50%;
  }
</style>
